begin unit_cell_cart
Ang
   -2.0931687950   -2.0931687950    0.0000000000
   -2.0931687950    0.0000000000   -2.0931687950
   -0.0000000000   -2.0931687950   -2.0931687950
end unit_cell_cart

begin atoms_frac
Ni           0.0000000000   0.0000000000   0.0000000000
O            0.5000000000   0.5000000000   0.5000000000
end atoms_frac

! system
num_wann = 8
num_bands = 8
mp_grid 5 5 5

! job control
exclude_bands : 1-5,14-16
iprint = 2

! plotting
wannier_plot = false
wannier_plot_supercell = 3
bands_plot = true
bands_num_points = 100
bands_plot_format = gnuplot
write_hr = true
write_u_matrices = true

! disentanglement
!dis_win_min = 11.0
!dis_win_max = 14.0
!dis_froz_min = 11.0
!dis_froz_max = 13.3
!dis_num_iter = 1000
!dis_conv_tol = 1.0E-9
!dis_mix_ratio = 0.9

! wannierisation
num_iter = 100
conv_window = 5
conv_tol = 1e-12

begin kpoint_path
G 0.000 0.000 0.000 X 0.500 0.000 0.500
X 0.500 0.000 0.500 W 0.500 0.250 0.750
W 0.500 0.250 0.750 K 0.375 0.375 0.750
K 0.375 0.375 0.750 G 0.000 0.000 0.000
G 0.000 0.000 0.000 L 0.500 0.500 0.500
L 0.500 0.500 0.500 U 0.625 0.250 0.625
U 0.625 0.250 0.625 W 0.500 0.250 0.750
W 0.500 0.250 0.750 L 0.500 0.500 0.500
L 0.500 0.500 0.500 K 0.375 0.375 0.750
end kpoint_path

begin projections
Ni:dxy,dyz,dz2,dxz,dx2-y2
O:px,py,pz
end projections

